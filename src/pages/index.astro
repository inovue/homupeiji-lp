<script is:inline>
"use strict";
const $=(s,c=document)=>c.querySelector(s), $$=(s,c=document)=>[...c.querySelectorAll(s)];
const root=document.documentElement;
const reduceMotion=matchMedia("(prefers-reduced-motion: reduce)").matches;

/* ---------- HTML-in-Canvas support detection ---------- */
const hic = (()=>{ try{
const t=document.createElement("canvas");
const ctx=t.getContext("2d");
return!!(ctx && typeof ctx.drawElementImage==="function");
}catch(e){ return false}})();

/* ---------- phases: driven by the real clock, not by the user ---------- */
const PHASE_LABEL={dawn:"暁の境内",noon:"昼の境内",dusk:"夕の境内",night:"夜の境内"};
function phaseFromClock(d){ const h=d.getHours();
  if(h>=5&&h<8) return "dawn"; if(h>=8&&h<16) return "noon"; if(h>=16&&h<19) return "dusk"; return "night"; }
const MAPS={ day:["assets/keidai-map2.webp","assets/keidai-map2-portrait.webp"],
             night:["assets/keidai-map2-night.webp","assets/keidai-map2-night-portrait.webp"] };
let lastPhase="";
function applyMapArt(p){
  const pair = p==="night"? MAPS.night : MAPS.day;
  const img=$(".mapimg"), sp=$("#mapSrcSP");
  if(img && img.getAttribute("src")!==pair[0]) img.setAttribute("src", pair[0]);
  if(sp && sp.getAttribute("srcset")!==pair[1]) sp.setAttribute("srcset", pair[1]);
}
(function preloadNight(){ MAPS.night.forEach(u=>{ const i=new Image(); i.src=u; }); })();
function tickClock(){
  const d=new Date(), p=phaseFromClock(d);
  root.dataset.phase=p;
  if(p!==lastPhase){ applyMapArt(p); lastPhase=p; }
  const hh=String(d.getHours()).padStart(2,"0"), mm=String(d.getMinutes()).padStart(2,"0");
  $("#clockStat").textContent=PHASE_LABEL[p]+" ― "+hh+":"+mm;
}
tickClock(); setInterval(tickClock, 30000);


/* ---------- camera: fly, drag, pinch, walk ---------- */
const mapwrap=$("#mapwrap");
const world=document.createElement("div"); world.className="world"; world.id="world";
[...mapwrap.children].forEach(ch=>{ if(!ch.classList.contains("hud")) world.appendChild(ch); });
mapwrap.appendChild(world);
const camReset=$("#camReset"), walkBtn=$("#walkBtn");
let cam={s:1,tx:0,ty:0};
function clampCam(){ const W=mapwrap.clientWidth,H=mapwrap.clientHeight;
  cam.tx=Math.min(0,Math.max(W-W*cam.s,cam.tx)); cam.ty=Math.min(0,Math.max(H-H*cam.s,cam.ty)); }
function applyCam(anim){
  world.style.transition=anim===false? "none": "";
  world.style.transform="translate("+cam.tx+"px,"+cam.ty+"px) scale("+cam.s+")";
  world.style.setProperty("--inv",String(1/cam.s));
  camReset.classList.toggle("show",cam.s>1.02);
  mapwrap.style.touchAction=cam.s>1.02? "none":"pan-y";
  if(anim===false) requestAnimationFrame(()=>{ world.style.transition=""; });
}
function spotXY(el){ const cs=getComputedStyle(el); return [parseFloat(cs.getPropertyValue("--x")), parseFloat(cs.getPropertyValue("--y"))]; }
function flyTo(x,y){
  const W=mapwrap.clientWidth,H=mapwrap.clientHeight;
  cam.s=innerWidth<=640?2.6:2.2;
  cam.tx=W/2-(x/100*W)*cam.s; cam.ty=H/2-(y/100*H)*cam.s;
  clampCam(); applyCam(true); travelDot(x,y);
  if(navigator.vibrate) setTimeout(()=>navigator.vibrate(10), reduceMotion?0:1150);
}
function resetCam(){ cam={s:1,tx:0,ty:0}; applyCam(true); walkIdx=-1; syncWalk(); }
camReset.addEventListener("click",()=>{ resetCam(); closeSheet(); });
addEventListener("keydown",e=>{ if(e.key==="Escape"){ resetCam(); closeSheet(); } });
function travelDot(x,y){
  if(reduceMotion) return;
  const svg=innerWidth<=640? $(".route-sp") : $(".route-pc"); if(!svg) return;
  const paths=[...svg.querySelectorAll("path")], tx=x*10, ty=y*10; let best=null;
  paths.forEach(p=>{ const L=p.getTotalLength();
    for(let i=0;i<=80;i++){ const pt=p.getPointAtLength(L*i/80);
      const d=(pt.x-tx)*(pt.x-tx)+(pt.y-ty)*(pt.y-ty);
      if(!best||d<best.d) best={p:p,d:d,len:L*i/80}; } });
  if(!best) return;
  const c=document.createElementNS("http://www.w3.org/2000/svg","circle");
  c.setAttribute("r","11"); c.setAttribute("fill","#f2b64b");
  c.setAttribute("stroke","#fff7e0"); c.setAttribute("stroke-width","3");
  svg.appendChild(c);
  const t0=performance.now(), dur=1000;
  (function step(now){
    const pr=Math.min(1,(now-t0)/dur), e=pr<.5? 2*pr*pr : 1-Math.pow(-2*pr+2,2)/2;
    const pt=best.p.getPointAtLength(best.len*e);
    c.setAttribute("cx",pt.x); c.setAttribute("cy",pt.y);
    c.setAttribute("opacity", String(pr>.8? (1-pr)*5 : 1));
    if(pr<1) requestAnimationFrame(step); else c.remove();
  })(t0);
}
/* drag to look around / pinch to zoom, once flown in */
const pointers=new Map(); let dragMoved=false, pinchD0=0, pinchS0=1;
mapwrap.addEventListener("pointerdown",e=>{
  if(e.target.closest(".hud")) return;
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size===2){ const v=[...pointers.values()];
    pinchD0=Math.hypot(v[0].x-v[1].x, v[0].y-v[1].y); pinchS0=cam.s; }
});
addEventListener("pointermove",e=>{
  if(!pointers.has(e.pointerId)) return;
  const prev=pointers.get(e.pointerId), dx=e.clientX-prev.x, dy=e.clientY-prev.y;
  pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pointers.size===1 && cam.s>1.02){
    if(Math.abs(dx)+Math.abs(dy)>2) dragMoved=true;
    cam.tx+=dx; cam.ty+=dy; clampCam(); applyCam(false);
  }else if(pointers.size===2){
    dragMoved=true;
    const v=[...pointers.values()], d=Math.hypot(v[0].x-v[1].x, v[0].y-v[1].y);
    if(pinchD0>0){
      const r=mapwrap.getBoundingClientRect(), mx=(v[0].x+v[1].x)/2-r.left, my=(v[0].y+v[1].y)/2-r.top;
      const ns=Math.min(3.4,Math.max(1,pinchS0*d/pinchD0));
      const wx=(mx-cam.tx)/cam.s, wy=(my-cam.ty)/cam.s;
      cam.s=ns; cam.tx=mx-wx*ns; cam.ty=my-wy*ns; clampCam(); applyCam(false);
    }
  }
});
function ptrEnd(e){ pointers.delete(e.pointerId); if(pointers.size<2) pinchD0=0;
  if(pointers.size===0) setTimeout(()=>{ dragMoved=false; },60); }
addEventListener("pointerup",ptrEnd); addEventListener("pointercancel",ptrEnd);
mapwrap.addEventListener("click",e=>{ if(dragMoved){ e.preventDefault(); e.stopPropagation(); } },true);
/* walk the sando, one tap per step */
const WALK=[["sanmon","山門"],["chozuya","手水舎"],["hondo","本堂"],["hodo","法堂"]];
let walkIdx=-1;
function syncWalk(){ if(!walkBtn) return;
  walkBtn.textContent = walkIdx<0? "参道を歩く" : (walkIdx>=WALK.length-1? "お参りをおえる" : "次は "+WALK[walkIdx+1][1]+" へ"); }
walkBtn.addEventListener("click",()=>{
  $("#top").scrollIntoView({behavior:reduceMotion?"auto":"smooth"});
  if(walkIdx>=WALK.length-1){ resetCam(); closeSheet(); return; }
  walkIdx++;
  const key=WALK[walkIdx][0], btn=document.querySelector('.spot[data-spot="'+key+'"]');
  const xy=spotXY(btn); flyTo(xy[0],xy[1]); openSheet(key); syncWalk();
});
syncWalk();

/* ---------- minimap: current position + flight ---------- */
const mmBtns=$$(".minimap button");
const mmMap={ "top":null,"sec-chozuya":"chozuya","sec-kyozo":"kyozo","sec-hondo":"hondo","sec-pagoda":"pagoda","sec-hodo":"hodo","sec-bell":"bell","sec-pond":"pond","sec-shoin":"shoin"};
mmBtns.forEach(b=>b.addEventListener("click",()=>{
const id=b.dataset.goto;
$("#top").scrollIntoView({behavior:reduceMotion?"auto":"smooth"});
if(id==="top"){ resetCam(); closeSheet(); return; }
const key=mmMap[id], btn=key&&document.querySelector('.spot[data-spot="'+key+'"]');
if(btn){ const xy=spotXY(btn); flyTo(xy[0],xy[1]); openSheet(key); walkIdx=WALK.findIndex(w=>w[0]===key); syncWalk(); }
}));
const secObs=new IntersectionObserver(es=>{
es.forEach(e=>{
if(!e.isIntersecting) return;
const key=e.target.id==="top"?"top":e.target.id;
mmBtns.forEach(b=>b.classList.toggle("now", b.dataset.goto===key));
});
},{rootMargin:"-38% 0px -50% 0px"});
secObs.observe($("#top")); $$("section.spotsec").forEach(s=>secObs.observe(s));

/* ---------- spot sheet ---------- */
const SPOTS={
sanmon:{t:"山門",b:"ここが入口です。順路は、手水舎、本堂の順。札や下の案内をタップすると、境内を飛んでその場所までご案内します。",go:"#sec-chozuya",gol:"参道へ進む"},
chozuya:{t:"手水舎",b:"寺号が水面に映る場所。文字は揺れても、実DOMのまま読める――それがこの寺の文字です。",go:"#sec-chozuya",gol:"手水舎へ行く"},
hondo:{t:"本堂",b:"法話を聴く場所。最新話と自己紹介エピソードへの入口があります。再生はSpotifyで。",go:"#sec-hondo",gol:"本堂へ行く"},
bell:{t:"鐘楼",b:"鐘を撞くと波紋が境内を渡り、札が揺れます。音は出ません。",go:"#sec-bell",gol:"鐘楼へ行く",bell:true},
pond:{t:"庭・池",b:"言葉を書くと、水面に映って沈む場所。送信も保存もされません。",go:"#sec-pond",gol:"池へ行く"},
pagoda:{name:"五重塔",en:"PAGODA",desc:"本堂の西。心柱が揺れを逃がす、空に置く手紙。"},
    kyozo:{name:"経蔵",en:"SUTRA STOREHOUSE",desc:"一切経の蔵。輪蔵を一回りさせれば、全部読んだことになります。"},
    hodo:{name:"法堂",en:"LECTURE HALL",desc:"本堂の真裏。法話の間。配信も、気持ちはここから。"},
    shoin:{t:"書院",b:"法話の言葉と、別院（Webアプリ・ミニゲーム）の棚。",go:"#sec-shoin",gol:"書院へ行く"}
};
const sheet=$("#sheet");
function openSheet(key){
const s=SPOTS[key]; if(!s) return;
$("#sheetTitle").textContent=s.t; $("#sheetBody").textContent=s.b;
const go=$("#sheetGo"); go.textContent=s.gol; go.setAttribute("href",s.go);
$("#sheetBell").style.display=s.bell?"inline-block":"none";
sheet.classList.add("open");
}
function closeSheet(){ sheet.classList.remove("open");}
const sheetGoEl=$(".sheet .go"); if(sheetGoEl) sheetGoEl.addEventListener("click",()=>resetCam());
(function(){
  const grab=$("#sheetGrab"), sheetEl=$("#sheet"); if(!grab||!sheetEl) return;
  let y0=null, dy=0;
  grab.addEventListener("pointerdown",e=>{ y0=e.clientY; dy=0; sheetEl.style.transition="none"; grab.setPointerCapture(e.pointerId); });
  grab.addEventListener("pointermove",e=>{ if(y0===null) return; dy=Math.max(0,e.clientY-y0);
    sheetEl.style.transform="translate(-50%,"+dy+"px)"; });
  grab.addEventListener("pointerup",()=>{ sheetEl.style.transition=""; sheetEl.style.transform="";
    if(dy>70) closeSheet(); y0=null; });
})();
$$(".spot").forEach(b=>b.addEventListener("click",()=>{ openSheet(b.dataset.spot); const xy=spotXY(b); flyTo(xy[0],xy[1]); walkIdx=WALK.findIndex(w=>w[0]===b.dataset.spot); syncWalk(); }));
$("#sheetClose").addEventListener("click",closeSheet);
$("#sheetGo").addEventListener("click",closeSheet);
document.addEventListener("keydown",e=>{ if(e.key==="Escape") closeSheet();});

/* ---------- bell ripple across the map (signature 2) ---------- */
const rc=$("#rippleCanvas"), rctx=rc.getContext("2d");
function sizeRipple(){ rc.width=innerWidth*devicePixelRatio; rc.height=innerHeight*devicePixelRatio; }
sizeRipple(); addEventListener("resize",sizeRipple);
let ripples=[];
function ringBell(fromEl){
  const wrap=$("#mapwrap").getBoundingClientRect();
  const bell=$("#bellSpot").getBoundingClientRect();
  const cx=(bell.left+bell.width/2), cy=(bell.top+bell.height/2);
  const inView = wrap.bottom>0 && wrap.top<innerHeight;
  ripples.push({x:cx,y:cy,r:0,max:Math.hypot(innerWidth,innerHeight),born:performance.now()});
  if(!reduceMotion) requestAnimationFrame(rippleLoop);
  // cards are "hit" when the wavefront reaches them
  $$(".spot").forEach(sp=>{
    const r=sp.getBoundingClientRect();
    const d=Math.hypot(r.left+r.width/2-cx, r.top+r.height/2-cy);
    setTimeout(()=>{ sp.classList.remove("hit"); void sp.offsetWidth; sp.classList.add("hit"); }, reduceMotion?0:d/1.1);
  });
  return inView;
}
function rippleLoop(now){
  rctx.clearRect(0,0,rc.width,rc.height);
  const dpr=devicePixelRatio;
  ripples=ripples.filter(rp=>rp.r<rp.max);
  for(const rp of ripples){
    rp.r+= (reduceMotion?0:7.5)*dpr;
    for(let k=0;k<3;k++){
      const rr=rp.r-k*26*dpr; if(rr<=0) continue;
      rctx.beginPath(); rctx.arc(rp.x*dpr,rp.y*dpr,rr,0,Math.PI*2);
      rctx.strokeStyle=`rgba(232,179,75,${Math.max(0,.55*(1-rp.r/rp.max)-k*.12)})`;
      rctx.lineWidth=2.2*dpr; rctx.stroke();
    }
  }
  if(ripples.length) requestAnimationFrame(rippleLoop); else rctx.clearRect(0,0,rc.width,rc.height);
}
$("#sheetBell").addEventListener("click",()=>{ closeSheet(); $("#top").scrollIntoView({behavior:reduceMotion?"auto":"smooth"}); setTimeout(()=>ringBell(), reduceMotion?0:650); });
$("#ringBtn").addEventListener("click",()=>{ $("#top").scrollIntoView({behavior:reduceMotion?"auto":"smooth"}); setTimeout(()=>ringBell(), reduceMotion?0:650); });
$("#ringTopBtn").addEventListener("click",()=>{ $("#top").scrollIntoView({behavior:reduceMotion?"auto":"smooth"}); });

/* ---------- chozuya reflection wobble ---------- */
(()=>{ const disp=$("#wobbleDisp"), turb=$("#wobbleTurb"); if(!disp||reduceMotion) return;
  let t=0; (function anim(){ t+=.016; disp.setAttribute("scale", String(6+Math.sin(t*.9)*2.4)); turb.setAttribute("baseFrequency", `${0.012+Math.sin(t*.5)*.002} 0.09`); requestAnimationFrame(anim); })();
})();

/* ---------- pond : sinking words (signature 3) ---------- */
const pc=$("#pondCanvas"), pctx=pc.getContext("2d");
const pondCard=$("#pondCard");
let pondNative = hic;
function drawPondScene(text, prog){
  const W=pc.width,H=pc.height;
  const g=pctx.createLinearGradient(0,0,0,H);
  const night=root.dataset.phase==="night";
  g.addColorStop(0, night?"#2c4a66":"#7fa3ba"); g.addColorStop(1, night?"#16283c":"#41657f");
  pctx.clearRect(0,0,W,H); pctx.fillStyle=g; pctx.fillRect(0,0,W,H);
  // lantern / moon glow
  pctx.fillStyle="rgba(240,220,160,.20)"; pctx.beginPath(); pctx.ellipse(W*.78,H*.22,150,44,0,0,Math.PI*2); pctx.fill();
  // ripples
  pctx.strokeStyle="rgba(240,244,246,.35)"; pctx.lineWidth=1.6;
  for(let i=0;i<4;i++){ const rr=26+i*22+((prog*140)%22);
    pctx.globalAlpha=Math.max(0,.5-i*.11-(prog*.25));
    pctx.beginPath(); pctx.ellipse(W/2,H*.46+prog*150, rr*2.1, rr*.62,0,0,Math.PI*2); pctx.stroke(); }
  pctx.globalAlpha=1;
  const yBase=H*.40+prog*(H*.42), alpha=1-prog*prog;
  const slices=16, sh=H*.16;
  let drawnNative=false;
  if(pondNative){
    try{
      const prev=pctx.globalAlpha; pctx.globalAlpha=alpha;
      for(let i=0;i<slices;i++){
        const off=Math.sin(prog*9+i*.85)* (2+prog*13);
        // 9-arg drawElementImage: source slice -> destination slice with sine offset
        pctx.drawElementImage(pondCard, 0, i*(pondCard.offsetHeight/slices), pondCard.offsetWidth, pondCard.offsetHeight/slices,
                                     W/2-pondCard.offsetWidth/2+off, yBase+i*(sh/slices), pondCard.offsetWidth, sh/slices);
      }
      pctx.globalAlpha=prev; drawnNative=true;
    }catch(e){ pondNative=false; }
  }
  if(!drawnNative){
    pctx.save(); pctx.globalAlpha=alpha;
    pctx.font="44px 'Hiragino Mincho ProN','Yu Mincho',serif"; pctx.textAlign="center"; pctx.fillStyle="#f4efdd";
    for(let i=0;i<slices;i++){
      const off=Math.sin(prog*9+i*.85)*(2+prog*13);
      pctx.save(); pctx.beginPath(); pctx.rect(0, yBase+i*(sh/slices)-sh/2, W, sh/slices+1); pctx.clip();
      pctx.fillText(text, W/2+off, yBase+16); pctx.restore();
    }
    pctx.restore();
  }
  return drawnNative;
}
(function pondIdle(){ drawPondScene($("#pondInput").value||"ねむれない夜", 0); })();
$("#pondTech").textContent = "";
let pondAnim=null;
$("#pondBtn").addEventListener("click",()=>{
  const text=($("#pondInput").value||"ねむれない夜").slice(0,18);
  pondCard.textContent=text;
  $("#pondStatus").textContent="";
  if(pondAnim) cancelAnimationFrame(pondAnim);
  if(reduceMotion){ drawPondScene(text,1); $("#pondStatus").textContent="沈みました。この気持ちに近い法話は、本堂にあります。"; return; }
  const t0=performance.now(), dur=3400; let usedNative=null;
  (function step(now){
    const p=Math.min(1,(now-t0)/dur), e=p*p*(3-2*p);
    const n=drawPondScene(text,e); if(usedNative===null) usedNative=n;
    if(p<1){ pondAnim=requestAnimationFrame(step); }
    else{
      drawPondScene(text,0);
      $("#pondStatus").textContent="沈みました。この気持ちに近い法話は、本堂にあります。";
      if(usedNative!==null) $("#pondTech").textContent = "";
    }
  })(t0);
});
$("#pondInput").addEventListener("input",e=>{ pondCard.textContent=e.target.value; drawPondScene(e.target.value||" ",0); });
</script>
</body>
