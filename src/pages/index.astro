---
// 電網山 訪夢平寺 LP — ページ本体は試作で検証済みの静的HTMLをそのまま使う。
// Astro側はこのファイルを dist/index.html として書き出すだけに留め、振る舞いは is:inline の CSS/JS が担う。
---
<!doctype html>
<html lang="ja" data-phase="dawn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>電網山 訪夢平寺｜AI am 坊主</title>
<meta name="description" content="AIに疲れたら、お寺へどうぞ。架空の寺・電網山訪夢平寺の境内をご案内します。ポッドキャスト「AI am 坊主」公式参拝ページ（試作）。">
<style is:inline>
:root{
  --ink:#2b2f33; --paper:#f4f1e8;
  --sky:#aeb9ca; --ground:#b9c0ab; --path:#ddd5c2; --water:#7f97a8;
  --roof:#4c5866; --warm:#e8b34b; --glow-o:0; --night-o:0;
  --card:#fbf9f3; --accent:#31556e;
  --serif:"Hiragino Mincho ProN","Hiragino Mincho Pro","Yu Mincho","YuMincho","Noto Serif JP",serif;
  --sans:"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic UI","Noto Sans JP",sans-serif;
}
html[data-phase="noon"]{ --sky:#c3d3dd; --ground:#bfc7a9; --water:#86a9bc; --roof:#55626f; --glow-o:0; --night-o:0; }
html[data-phase="dusk"]{ --sky:#c99b6d; --ground:#a9a184; --water:#7d8b9b; --roof:#4a4a55; --warm:#f0a845; --glow-o:.55; --night-o:.18; }
html[data-phase="night"]{ --sky:#1d2739; --ground:#3c4653; --path:#6d6a5e; --water:#33506b; --roof:#232b38; --ink:#e8e2d2; --card:#232b38; --paper:#161d29; --glow-o:1; --night-o:.38; --accent:#d9b45c; }
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:var(--serif);color:var(--ink);background:var(--paper);transition:background 1.2s ease,color 1.2s ease}
a{color:inherit}
header.site{position:fixed;inset:0 0 auto 0;z-index:60;display:flex;align-items:center;gap:14px;padding:10px 16px;background:color-mix(in srgb,var(--paper) 82%,transparent);backdrop-filter:blur(6px);border-bottom:1px solid color-mix(in srgb,var(--ink) 14%,transparent)}
header.site .brand{font-size:15px;letter-spacing:.18em}
header.site .brand small{font-family:var(--sans);font-size:10px;letter-spacing:.12em;opacity:.75;display:block}
header.site nav{margin-left:auto;display:flex;gap:6px;align-items:center}
.phasebtn{font-family:var(--sans);font-size:12px;border:1px solid color-mix(in srgb,var(--ink) 30%,transparent);background:transparent;color:var(--ink);border-radius:999px;padding:5px 12px;cursor:pointer}
.phasebtn[aria-pressed="true"]{background:var(--ink);color:var(--paper)}
.badge{font-family:var(--sans);font-size:10px;padding:4px 9px;border-radius:999px;border:1px solid color-mix(in srgb,var(--ink) 25%,transparent);white-space:nowrap}
.badge b{color:#3d7a44} html[data-phase="night"] .badge b{color:#9ed08a}
.clockstat{font-family:var(--sans);font-size:11px;letter-spacing:.14em;color:var(--ink);opacity:.85;white-space:nowrap}
.clockstat .cdot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:7px;vertical-align:1px}
main{display:block}

.mapimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;transition:filter 1.2s ease}
html[data-phase="noon"] .mapimg{filter:brightness(1.07) saturate(1.08)}
html[data-phase="dusk"] .mapimg{filter:sepia(.30) hue-rotate(-10deg) brightness(.93)}
html[data-phase="night"] .mapimg{filter:brightness(.48) hue-rotate(14deg) saturate(.75)}
.routeSvg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:3}
.route-sp{display:none}
.scrim{position:absolute;left:0;right:0;bottom:0;height:36%;background:linear-gradient(transparent,rgba(10,16,24,.45));pointer-events:none;z-index:2}
.lamp{position:absolute;width:38px;height:38px;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(255,198,90,.95) 0%,rgba(255,176,66,.42) 40%,transparent 70%);opacity:var(--glow-o);transition:opacity 1.2s ease;pointer-events:none;mix-blend-mode:screen;z-index:3}
.spot{left:var(--x);top:var(--y)}
.sp-sanmon{--x:51.5%;--y:82%} .sp-chozuya{--x:33.8%;--y:68.2%} .sp-hondo{--x:49.8%;--y:33.2%}
.sp-bell{--x:64.5%;--y:56.2%} .sp-pond{--x:18.8%;--y:78.4%} .sp-shoin{--x:79.7%;--y:50%}
.sp-pagoda{--x:20.4%;--y:26.8%} .sp-kyozo{--x:33.1%;--y:54%} .sp-hodo{--x:49.8%;--y:12.8%}

/* ---------- HERO MAP ---------- */
.hero{position:relative;padding:16px 12px 26px}
.mapwrap{position:relative;max-width:1240px;margin:0 auto;border-radius:20px;overflow:hidden;background:#f6f3ec;box-shadow:0 24px 60px rgba(20,26,34,.20);aspect-ratio:3/2}
.herohead{max-width:1240px;margin:0 auto 14px;display:flex;justify-content:space-between;align-items:flex-end;gap:16px;padding:0 4px}
.mapwrap svg.map{position:absolute;inset:0;width:100%;height:100%}
.mapwrap .nightveil{position:absolute;inset:0;background:#0d1524;opacity:var(--night-o);pointer-events:none;transition:opacity 1.2s ease}
.hero h1{font-size:clamp(28px,4.6vw,52px);letter-spacing:.14em;margin:0;color:var(--ink)}
.hero h1 .yomi{display:block;font-size:11px;letter-spacing:.32em;margin-bottom:7px;font-family:var(--sans);color:var(--accent)}
.hero .tagline{color:var(--ink);font-size:clamp(14px,2vw,20px);letter-spacing:.08em;text-align:right}
.hero .tagline small{display:block;font-family:var(--sans);font-size:11px;letter-spacing:.12em;margin-top:6px;opacity:.75}
.spot{position:absolute;z-index:6;transform:translate(-50%,-100%);background:var(--card);color:var(--ink);border:1px solid rgba(43,47,51,.25);border-radius:8px;padding:6px 10px 5px;font-family:var(--serif);cursor:pointer;box-shadow:0 6px 18px rgba(15,20,28,.28);text-align:center;transition:transform .25s ease, box-shadow .25s ease}
.spot .no{font-family:var(--sans);font-size:9px;letter-spacing:.2em;color:var(--accent);display:block}
.spot .nm{font-size:15px;letter-spacing:.14em;white-space:nowrap}
.spot::after{content:"";position:absolute;left:50%;bottom:-7px;width:8px;height:8px;background:inherit;border-right:1px solid rgba(43,47,51,.25);border-bottom:1px solid rgba(43,47,51,.25);transform:translateX(-50%) rotate(45deg)}
.spot:hover,.spot:focus-visible{transform:translate(-50%,-108%) scale(1.05)}
.spot.hit{animation:cardhit .9s ease}
@keyframes cardhit{0%{transform:translate(-50%,-100%)}25%{transform:translate(-50%,-100%) rotate(-2.2deg) scale(1.07);box-shadow:0 0 0 6px rgba(232,179,75,.35),0 10px 24px rgba(15,20,28,.3)}60%{transform:translate(-50%,-100%) rotate(1.4deg)}100%{transform:translate(-50%,-100%)}}
.routehint{position:absolute;right:26px;top:84px;z-index:5;color:#f7f3e6;font-family:var(--sans);font-size:11px;letter-spacing:.16em;text-shadow:0 1px 10px rgba(10,16,24,.65)}
.scrolldown{margin:14px auto 18px;font-family:var(--sans);font-size:11px;letter-spacing:.3em;opacity:.75;text-align:center}
/* spot panel (bottom sheet) */
.sheet{position:fixed;left:50%;bottom:14px;transform:translate(-50%,140%);width:min(560px,calc(100vw - 24px));background:#fbf9f3;color:#2b2f33;border-radius:14px;box-shadow:0 18px 50px rgba(10,15,22,.35);padding:18px 20px 16px;z-index:70;transition:transform .35s cubic-bezier(.2,.9,.25,1)}
.sheet.open{transform:translate(-50%,0)}
.sheet h3{margin:0 0 6px;font-size:19px;letter-spacing:.12em}
.sheet p{margin:0 0 12px;font-size:14px;line-height:1.8}
.sheet .go{display:inline-block;font-family:var(--sans);font-size:12px;background:#2b2f33;color:#f7f3e6;border-radius:999px;padding:8px 16px;text-decoration:none}
.sheet .close{position:absolute;top:8px;right:12px;border:0;background:none;font-size:18px;cursor:pointer;color:#2b2f33}
/* ---------- SECTIONS ---------- */
section.spotsec{max-width:880px;margin:0 auto;padding:110px 22px 30px}
section.spotsec .kicker{font-family:var(--sans);font-size:11px;letter-spacing:.3em;color:var(--accent)}
section.spotsec h2{font-size:clamp(26px,4.4vw,40px);letter-spacing:.14em;margin:10px 0 14px}
section.spotsec p.lead{font-size:16px;line-height:2.05}
.demo{background:color-mix(in srgb,var(--card) 88%,transparent);border:1px solid color-mix(in srgb,var(--ink) 16%,transparent);border-radius:14px;padding:18px;margin-top:22px}
.demo h3{margin:0 0 8px;font-size:15px;letter-spacing:.1em}
.demo p{font-size:13.5px;line-height:1.9;margin:6px 0}
.btn{font-family:var(--sans);font-size:13px;border-radius:999px;border:1px solid var(--ink);background:var(--ink);color:var(--paper);padding:9px 20px;cursor:pointer}
.btn.ghost{background:transparent;color:var(--ink)}
input.phrase{font-family:var(--serif);font-size:16px;padding:10px 12px;border-radius:8px;border:1px solid color-mix(in srgb,var(--ink) 35%,transparent);background:#fff;color:#2b2f33;width:min(340px,100%)}
canvas.stage{display:block;width:100%;height:auto;border-radius:10px;background:#22384c}
.reflectbox{position:relative;height:150px;border-radius:10px;overflow:hidden;background:linear-gradient(180deg,#8fa9bb,#5f7f96)}
.reflectbox .base{position:absolute;inset:auto 0 52% 0;text-align:center;font-size:34px;letter-spacing:.3em;color:#f4efdd;padding-top:16px}
.reflectbox .refl{position:absolute;inset:52% 0 auto 0;text-align:center;font-size:34px;letter-spacing:.3em;color:rgba(244,239,221,.75);transform:scaleY(-1);filter:url(#wobble)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-top:20px}
.card{background:var(--card);color:#2b2f33;border:1px solid rgba(43,47,51,.16);border-radius:12px;padding:16px 16px 14px;text-decoration:none;display:block;transition:transform .2s ease}
html[data-phase="night"] .card{color:#e8e2d2}
.card:hover{transform:translateY(-3px)}
.card .t{font-size:15.5px;line-height:1.7;letter-spacing:.04em}
.card .m{font-family:var(--sans);font-size:11px;opacity:.75;margin-top:8px;letter-spacing:.08em}
.card .tag{display:inline-block;font-family:var(--sans);font-size:10px;border:1px solid currentColor;border-radius:999px;padding:2px 8px;margin-bottom:10px;letter-spacing:.14em}
/* minimap */
.minimap{position:fixed;left:14px;bottom:14px;z-index:65;background:color-mix(in srgb,var(--card) 92%,transparent);border:1px solid color-mix(in srgb,var(--ink) 18%,transparent);border-radius:12px;padding:8px 10px 6px;box-shadow:0 10px 30px rgba(10,15,22,.22)}
.minimap .cap{font-family:var(--sans);font-size:9px;letter-spacing:.24em;opacity:.7;margin-bottom:4px;color:#2b2f33}
html[data-phase="night"] .minimap .cap{color:#e8e2d2}
.minimap button{display:block;width:100%;text-align:left;border:0;background:none;font-family:var(--sans);font-size:11px;padding:3px 4px;cursor:pointer;color:#2b2f33;border-radius:6px}
html[data-phase="night"] .minimap button{color:#e8e2d2}
.minimap button .dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#b9b2a0;margin-right:7px;vertical-align:1px}
.minimap button.now .dot{background:var(--warm);box-shadow:0 0 8px var(--warm)}
.minimap button.now{background:color-mix(in srgb,var(--warm) 18%,transparent)}
#rippleCanvas{position:fixed;inset:0;z-index:55;pointer-events:none}
footer{margin-top:120px;padding:70px 22px 90px;text-align:center;border-top:1px solid color-mix(in srgb,var(--ink) 14%,transparent)}
footer .bye{font-size:22px;letter-spacing:.2em}
footer nav{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px}
footer nav a{font-family:var(--sans);font-size:12px;border:1px solid color-mix(in srgb,var(--ink) 30%,transparent);padding:8px 16px;border-radius:999px;text-decoration:none}
footer small{display:block;margin-top:26px;font-family:var(--sans);font-size:10px;opacity:.65;letter-spacing:.1em;line-height:1.9}
.note{font-family:var(--sans);font-size:11px;opacity:.75;line-height:1.9}
@media (max-width:640px){
  .routehint{display:none}
  .spot .nm{font-size:12.5px}
  .spot{padding:5px 8px 4px}
  .minimap{left:10px;right:10px;bottom:10px;padding:6px 8px;display:flex;gap:2px;overflow-x:auto;align-items:center}
  .minimap .cap{display:none}
  .minimap button{font-size:10px;padding:4px 6px;width:auto;white-space:nowrap;flex:0 0 auto}
  header.site .brand small{display:none}
  .badge{display:none}
  section.spotsec{padding-top:84px}

  .route-pc{display:none} .route-sp{display:block}
  .lamp{display:none}
  .sp-sanmon{--x:51.8%;--y:88.7%} .sp-chozuya{--x:33.3%;--y:70.7%} .sp-hondo{--x:50.4%;--y:31.5%}
  .sp-bell{--x:66.4%;--y:59.4%} .sp-pond{--x:17.1%;--y:81.4%} .sp-shoin{--x:83%;--y:49.4%}
  .sp-pagoda{--x:17.8%;--y:28.6%} .sp-kyozo{--x:32.1%;--y:54.6%} .sp-hodo{--x:50.6%;--y:8.5%}
  .mapwrap{aspect-ratio:1/2}
  .herohead{flex-direction:column;align-items:flex-start}
  .hero .tagline{text-align:left}

}
@media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto} *{animation:none!important;transition:none!important} }

/* ---------- app-style bottom navigation bar ---------- */
.minimap{left:50%;right:auto;top:auto;bottom:12px;transform:translateX(-50%);border-radius:999px;padding:6px;max-width:96vw;width:auto;display:flex;flex-direction:row;align-items:center;gap:2px;overflow-x:auto;scrollbar-width:none}
.minimap::-webkit-scrollbar{display:none}
.minimap .cap{display:none}
.minimap button{border-radius:999px;padding:7px 11px;white-space:nowrap;font-size:12px;width:auto;flex:0 0 auto}
html .minimap button.now{background:var(--ink);color:var(--paper)}
.minimap button.now .dot{background:var(--accent);box-shadow:none}
.sheet{bottom:78px;transform:translate(-50%,calc(100% + 100px));visibility:hidden;transition:transform .35s cubic-bezier(.2,.9,.25,1),visibility 0s linear .35s}
.sheet.open{transform:translate(-50%,0);visibility:visible;transition:transform .35s cubic-bezier(.2,.9,.25,1),visibility 0s}

/* ---------- diegetic typography: text lives inside the map ---------- */
.plaque{position:absolute;left:51.5%;top:75.5%;transform:translate(-50%,-50%);z-index:6;display:flex;align-items:center;background:linear-gradient(180deg,#4a3a2a,#37281c);border:2px solid #c8a75a;border-radius:6px;padding:8px 18px 9px;color:#ecd9a0;width:max-content;box-shadow:0 10px 24px rgba(10,15,22,.45), inset 0 0 0 3px rgba(0,0,0,.22);letter-spacing:.26em;font-size:clamp(17px,2.2vw,26px);margin:0;font-weight:600}
.plaque .sango{writing-mode:vertical-rl;font-size:.5em;letter-spacing:.28em;border-right:1px solid rgba(236,217,160,.45);padding-right:.55em;margin-right:.65em}
html[data-phase="night"] .plaque{box-shadow:0 0 24px rgba(240,180,80,.38),0 10px 24px rgba(0,0,0,.5), inset 0 0 0 3px rgba(0,0,0,.22)}
.signboard{position:absolute;left:24%;top:93%;width:max-content;transform:translate(-50%,-100%) rotate(-1.4deg);z-index:6;background:linear-gradient(180deg,#f8f1de,#efe3c6);color:#3a3125;border:1px solid #b39b62;border-radius:4px;box-shadow:0 8px 18px rgba(10,15,22,.30), inset 0 0 0 3px #fbf7ea;padding:9px 14px 8px;font-size:clamp(12px,1.4vw,15px);letter-spacing:.05em;max-width:300px}
.signboard small{display:block;font-family:var(--sans);font-size:10px;opacity:.75;margin-top:4px;letter-spacing:.06em;line-height:1.6}
.signboard::before,.signboard::after{content:"";position:absolute;bottom:-13px;width:5px;height:13px;background:#6b543a;border-radius:0 0 2px 2px}
.signboard::before{left:20px}.signboard::after{right:20px}
.hud{position:absolute;top:10px;z-index:8;display:flex;align-items:center;gap:7px;background:rgba(16,22,32,.55);backdrop-filter:blur(6px);color:#f2ecdc;font-family:var(--sans);font-size:11px;letter-spacing:.1em;padding:6px 12px;border-radius:999px;text-decoration:none}
.hud-left{left:10px}.hud-right{right:10px}
.hud .cdot{width:7px;height:7px;border-radius:50%;background:var(--accent)}
section.spotsec .kicker{display:inline-block;background:linear-gradient(180deg,#4a3a2a,#37281c);color:#ecd9a0;border:1px solid #c8a75a;border-radius:4px;padding:5px 12px;letter-spacing:.22em}
.sp-sanmon{--x:38.5%;--y:90%}
@media (max-width:640px){
  .plaque{left:51.8%;top:84%;font-size:16px;padding:6px 13px 7px}
  .signboard{left:50%;top:98.2%;max-width:250px;font-size:11.5px;transform:translate(-50%,-100%) rotate(1.2deg)}
  .signboard small{display:none}
  .sp-sanmon{--x:84%;--y:90%}
  .hud-right{display:none}
}

/* ---------- camera flight ---------- */
.world{position:absolute;inset:0;transform-origin:0 0;transition:transform 1.15s cubic-bezier(.25,.8,.25,1);will-change:transform}
.spot{transform:translate(-50%,-100%) scale(var(--inv,1))}
.plaque{transform:translate(-50%,-50%) scale(var(--inv,1))}
.signboard{transform:translate(-50%,-100%) rotate(-1.4deg) scale(var(--inv,1))}
.hud-reset{left:50%;right:auto;transform:translateX(-50%);border:0;cursor:pointer;opacity:0;visibility:hidden;transition:opacity .3s ease,visibility 0s linear .3s}
.hud-reset.show{opacity:1;visibility:visible;transition:opacity .3s ease}
@media (max-width:640px){ .signboard{transform:translate(-50%,-100%) rotate(1.2deg) scale(var(--inv,1))} }

/* ---------- walk mode, sheet grab, mobile refinement ---------- */
.hud-walk{top:auto;bottom:10px;right:10px;left:auto;background:var(--accent);color:#241a08;font-weight:700;border:0;cursor:pointer;box-shadow:0 8px 20px rgba(10,15,22,.35)}
.sheetgrab{display:flex;justify-content:center;padding:2px 0 10px;cursor:grab;touch-action:none}
.sheetgrab span{display:block;width:46px;height:5px;border-radius:99px;background:#c9c2ae}
.mapwrap{touch-action:pan-y}
@media (max-width:640px){
  .hero{padding:10px 0 22px}
  .mapwrap{border-radius:0;max-width:none}
  .minimap{bottom:calc(12px + env(safe-area-inset-bottom))}
  .spot{padding:8px 12px 7px}
}

/* ---------- real night map (generated night artwork) ---------- */
html[data-phase="night"] .mapimg{filter:none}
html[data-phase="night"] .nightveil{opacity:.10}
html[data-phase="night"] .lamp{opacity:0}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="wobble" x="-5%" y="-40%" width="110%" height="180%">
    <feTurbulence id="wobbleTurb" type="fractalNoise" baseFrequency="0.012 0.09" numOctaves="2" seed="7" result="n"/>
    <feDisplacementMap id="wobbleDisp" in="SourceGraphic" in2="n" scale="7"/>
  </filter>
</svg>
<canvas id="rippleCanvas" aria-hidden="true"></canvas>
<main>
  <!-- ================= HERO : PRECINCT MAP ================= -->
  <div class="hero" id="top">
    <div class="mapwrap" id="mapwrap" role="img" aria-label="訪夢平寺の境内図。山門から参道が本堂へ続き、手水舎、経蔵、鐘楼、池、書院、五重塔、法堂があります。">
      <picture>
        <source id="mapSrcSP" media="(max-width: 640px)" srcset="assets/keidai-map2-portrait.webp">
        <img class="mapimg" src="assets/keidai-map2.webp" alt="" aria-hidden="true">
      </picture>
      <svg class="routeSvg route-pc" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
        <path d="M512 795 C 508 680, 504 540, 501 375" fill="none" stroke="#e8b34b" stroke-width="4" stroke-dasharray="2 12" stroke-linecap="round" opacity=".95"/>
        <path d="M507 628 C 455 645, 395 662, 345 676" fill="none" stroke="#e8b34b" stroke-width="4" stroke-dasharray="2 12" stroke-linecap="round" opacity=".95"/>
      </svg>
      <svg class="routeSvg route-sp" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
        <path d="M516 862 C 511 700, 507 520, 505 352" fill="none" stroke="#e8b34b" stroke-width="5" stroke-dasharray="2 13" stroke-linecap="round" opacity=".95"/>
        <path d="M511 655 C 445 675, 385 692, 340 702" fill="none" stroke="#e8b34b" stroke-width="5" stroke-dasharray="2 13" stroke-linecap="round" opacity=".95"/>
      </svg>
      <div class="lamp" style="left:45.7%;top:45.5%"></div><div class="lamp" style="left:54.6%;top:45.5%"></div>
      <div class="lamp" style="left:45.3%;top:52.5%"></div><div class="lamp" style="left:54.7%;top:52.5%"></div>
      <div class="lamp" style="left:45.2%;top:63.5%"></div><div class="lamp" style="left:56%;top:63.5%"></div>
      <div class="nightveil"></div>
      <h1 class="plaque"><span class="sango">電網山</span><span class="main">訪夢平寺</span></h1>
