---
// 立体別院（実験）：Blender製ペーパークラフト境内を Three.js で歩く。
// 本編LPには混ぜず、別院ページとして切り分ける。読み込み失敗時はメッセージのみ。
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>立体別院 ― 3D境内（実験）｜電網山 訪夢平寺</title>
<meta name="description" content="Blenderで組んだペーパークラフト境内を、ブラウザの中で歩く実験ページ。時刻で光が変わります。">
<style>
  :root{ --ink:#e8e2cf; --gold:#c8a75a; }
  *{ box-sizing:border-box; }
  html,body{ margin:0; padding:0; background:#0d1524; }
  body{ font-family:"Hiragino Mincho ProN","Yu Mincho","Noto Serif CJK JP",serif; color:var(--ink); }
  /* scroll track for the pilgrimage (scroll mode) */
  #track{ height:520vh; }
  body.free #track{ height:100vh; }
  #stage{ position:fixed; inset:0; }
  #stage canvas{ display:block; width:100%; height:100%; }
  .hud{ position:fixed; z-index:10; background:rgba(10,15,24,.55); border:1px solid rgba(200,167,90,.45);
        border-radius:99px; padding:7px 14px; font-size:12px; letter-spacing:.12em; backdrop-filter:blur(6px); }
  .hud-title{ top:12px; left:12px; }
  .hud-phase{ top:12px; right:12px; display:flex; gap:6px; align-items:center; }
  .hud-phase button{ background:none; border:1px solid transparent; color:var(--ink); font:inherit; font-size:11px;
        padding:2px 8px; border-radius:99px; cursor:pointer; letter-spacing:.08em; }
  .hud-phase button.on{ border-color:var(--gold); color:#f2cf8b; }
  .hud-bar{ left:50%; bottom:calc(12px + env(safe-area-inset-bottom)); transform:translateX(-50%);
        display:flex; gap:2px; max-width:96vw; overflow-x:auto; scrollbar-width:none; }
  .hud-bar::-webkit-scrollbar{ display:none; }
  .hud-bar button{ background:none; border:0; color:var(--ink); font:inherit; font-size:12px; white-space:nowrap;
        padding:4px 10px; border-radius:99px; cursor:pointer; letter-spacing:.1em; }
  .hud-bar button.on{ background:rgba(200,167,90,.25); color:#f2cf8b; }
  .hud-mode{ right:12px; bottom:calc(12px + env(safe-area-inset-bottom)); cursor:pointer; color:#f2cf8b; }
  @media (max-width:640px){ .hud-mode{ bottom:calc(64px + env(safe-area-inset-bottom)); } }
  .cap{ position:fixed; left:0; right:0; bottom:18vh; z-index:5; text-align:center; pointer-events:none;
        opacity:0; transition:opacity .3s linear; padding:0 20px; }
  .cap .k{ font-family:ui-sans-serif,system-ui,sans-serif; font-size:11px; letter-spacing:.34em; color:#f2cf8b; }
  .cap h2{ margin:8px 0 6px; font-size:clamp(22px,4.6vw,34px); font-weight:600; letter-spacing:.08em;
        text-shadow:0 2px 18px rgba(0,0,0,.65); }
  .cap p{ margin:0; font-size:clamp(13px,2.6vw,15px); line-height:1.9; text-shadow:0 1px 12px rgba(0,0,0,.7); }
  #scrollHint{ position:fixed; left:50%; bottom:11vh; transform:translateX(-50%); z-index:6; font-size:12px;
        letter-spacing:.3em; color:var(--ink); opacity:.85; animation:bob 2.2s ease-in-out infinite; pointer-events:none; }
  body.free #scrollHint{ display:none; }
  @keyframes bob{ 0%,100%{ transform:translate(-50%,0);} 50%{ transform:translate(-50%,7px);} }
  #fallback{ position:fixed; inset:0; display:none; place-items:center; text-align:center; padding:24px; line-height:2; }
  .credit{ position:fixed; left:12px; bottom:calc(12px + env(safe-area-inset-bottom)); z-index:9; font-size:10px; opacity:.55; letter-spacing:.08em; }
  @media (max-width:640px){ .credit{ display:none; } }
</style>
</head>
<body>
<div id="track"></div>
<div id="stage" aria-label="3D境内"></div>

<div class="hud hud-title">立体別院 ― 3D境内（実験）</div>
<div class="hud hud-phase" id="phaseBar" role="group" aria-label="時刻">
  <button data-phase="dawn">暁</button><button data-phase="noon">昼</button><button data-phase="dusk">夕</button><button data-phase="night">夜</button>
</div>
<div id="scrollHint">SCROLL ― 参拝する</div>

<div class="cap" data-cap="0"><div class="k">KEIDAI ― 境内</div><h2>電網山 訪夢平寺</h2><p>スクロールで、山門から奥へ歩きます。</p></div>
<div class="cap" data-cap="1"><div class="k">1 ― GATE</div><h2>山門</h2><p>ここが入口です。扁額の寺号は、ここに掛かっています。</p></div>
<div class="cap" data-cap="2"><div class="k">2 ― WATER</div><h2>手水舎</h2><p>手を清めてから、どうぞ。参道の西脇にあります。</p></div>
<div class="cap" data-cap="3"><div class="k">3 ― MAIN HALL</div><h2>本堂</h2><p>法話はここから届けています。住職・飯音三休のお寺です。</p></div>
<div class="cap" data-cap="4"><div class="k">4 ― LECTURE HALL</div><h2>法堂</h2><p>本堂の真裏、説法の間。一番奥まで来ました。</p></div>
<div class="cap" data-cap="5"><div class="k">PAGODA</div><h2>五重塔</h2><p>本堂の西に立つ塔。空に置く手紙です。</p></div>
<div class="cap" data-cap="6"><div class="k">KEIDAI ― 境内</div><h2>また、お越しください</h2><p>下のボタンからは、自由に歩けます。</p></div>

<nav class="hud hud-bar" id="flyBar" aria-label="場所へ飛ぶ">
  <button data-fly="all" class="on">全体</button><button data-fly="sanmon">山門</button><button data-fly="chozuya">手水舎</button><button data-fly="hondo">本堂</button><button data-fly="hodo">法堂</button><button data-fly="pagoda">五重塔</button><button data-fly="bell">鐘楼</button>
</nav>
<button class="hud hud-mode" id="modeBtn" type="button">自由に歩く</button>
<div class="credit">Blender × Three.js ― ペーパークラフト境内 v4</div>
<div id="fallback"><div>この端末では3Dを表示できませんでした。<br><a href="../" style="color:#f2cf8b">境内マップ（本編）へもどる</a></div></div>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
import { MeshoptDecoder } from 'three/addons/libs/meshopt_decoder.module.js';
import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';
import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

const stage = document.getElementById('stage');
let renderer;
try {
  renderer = new THREE.WebGLRenderer({ antialias:true, powerPreference:'high-performance' });
} catch(e) {
  document.getElementById('fallback').style.display = 'grid';
  throw e;
}
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
stage.appendChild(renderer.domElement);

const scene = new THREE.Scene();
const pmrem = new THREE.PMREMGenerator(renderer);
scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
scene.environmentIntensity = 0.1;
scene.background = new THREE.Color(0x0d1524);
scene.fog = new THREE.Fog(0x0d1524, 55, 120);
const camera = new THREE.PerspectiveCamera(46, innerWidth/innerHeight, 0.1, 300);
camera.position.set(19, 14, 23);

const hemi = new THREE.HemisphereLight(0xbdd0e8, 0x2c2c22, 0.25);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0x8fb4ff, 0.55);
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
sun.shadow.camera.left = -19; sun.shadow.camera.right = 19;
sun.shadow.camera.top = 19; sun.shadow.camera.bottom = -19;
sun.shadow.camera.far = 80; sun.shadow.bias = -0.0006;
scene.add(sun); scene.add(sun.target);

/* stone lanterns along the sando (lights fade in with the dark) */
const lanterns = [];
[8.2, 4.6, 1.0, -2.6].forEach(z => {
  [-1.7, 1.7].forEach(x => {
    const p = new THREE.PointLight(0xffa64d, 0, 7, 1.8);
    p.position.set(x, 1.15, z);
    scene.add(p); lanterns.push(p);
  });
});

/* ---- phases: the real clock decides, chips override for looking ---- */
const PHASES = {
  dawn:  { envI:0.08, sun:0xffb877, sunI:1.7, sunPos:[-16,7,12],  hemiI:0.5,  bg:0x35445e, fog:[40,110], lantern:5,  win:0.5,  bloom:0.28, expo:1.0 },
  noon:  { envI:0.12, sun:0xfff1da, sunI:2.5, sunPos:[11,19,7],   hemiI:0.55,  bg:0xd6dbcc, fog:[70,160], lantern:0,  win:0.0,  bloom:0.10, expo:1.0 },
  dusk:  { envI:0.08, sun:0xff9a56, sunI:1.5, sunPos:[-16,4,-5],  hemiI:0.45, bg:0x3c4664, fog:[42,115], lantern:7,  win:0.75, bloom:0.38, expo:1.0 },
  night: { envI:0.05, sun:0x8fb4ff, sunI:0.55, sunPos:[-9,15,-7], hemiI:0.32, bg:0x0d1524, fog:[48,120], lantern:9,  win:1.25, bloom:0.62, expo:1.05 }
};
let winMats = [];
function applyPhase(name){
  const P = PHASES[name]; if(!P) return;
  sun.color.setHex(P.sun); sun.intensity = P.sunI;
  sun.position.set(...P.sunPos);
  hemi.intensity = P.hemiI;
  scene.environmentIntensity = P.envI ?? 0.1;
  scene.background.setHex(P.bg);
  scene.fog.color.setHex(P.bg); scene.fog.near = P.fog[0]; scene.fog.far = P.fog[1];
  lanterns.forEach(l => l.intensity = P.lantern);
  winMats.forEach(m => m.emissiveIntensity = P.win);
  bloomPass.strength = P.bloom;
  renderer.toneMappingExposure = P.expo;
  document.querySelectorAll('#phaseBar button').forEach(b => b.classList.toggle('on', b.dataset.phase === name));
}
const clockPhase = () => { const h = new Date().getHours(); return h>=5&&h<8 ? 'dawn' : h>=8&&h<16 ? 'noon' : h>=16&&h<19 ? 'dusk' : 'night'; };
let phaseWanted = new URLSearchParams(location.search).get('phase') || clockPhase();

/* ---- load the precinct ---- */
const loader = new GLTFLoader();
loader.setMeshoptDecoder(MeshoptDecoder);
loader.load('../assets/keidai-v4.glb', (gltf) => {
  const model = gltf.scene;
  const paperMats = new Set();
  model.traverse(o => {
    if (o.isMesh) {
      o.castShadow = true; o.receiveShadow = true;
      if (o.material && o.material.isMeshStandardMaterial && !/Window/.test(o.name)) {
        o.material.vertexColors = true;
        paperMats.add(o.material);
      }
      if (/Window/.test(o.name)) {
        const m = new THREE.MeshStandardMaterial({ color:0x2a2118, emissive:0xffb45c, emissiveIntensity:0, roughness:.6 });
        o.material = m; winMats.push(m);
      }
      if (o.material && o.material.name === 'pond_water') {
        o.material.roughness = 0.12; o.material.metalness = 0.25;
      }
    }
  });
  paperMats.forEach(m => {
    m.onBeforeCompile = (sh) => {
      sh.vertexShader = 'varying vec3 vPaperWP;\n' + sh.vertexShader.replace(
        '#include <worldpos_vertex>',
        '#include <worldpos_vertex>\n vPaperWP = (modelMatrix * vec4(transformed,1.0)).xyz;');
      sh.fragmentShader = ('varying vec3 vPaperWP;\n' +
        'float phash(vec3 p){ p=fract(p*0.3183099+vec3(0.1,0.17,0.13)); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }\n' +
        'float pnoise(vec3 x){ vec3 i=floor(x); vec3 f=fract(x); f=f*f*(3.0-2.0*f);' +
        ' return mix(mix(mix(phash(i+vec3(0,0,0)),phash(i+vec3(1,0,0)),f.x),mix(phash(i+vec3(0,1,0)),phash(i+vec3(1,1,0)),f.x),f.y),' +
        ' mix(mix(phash(i+vec3(0,0,1)),phash(i+vec3(1,0,1)),f.x),mix(phash(i+vec3(0,1,1)),phash(i+vec3(1,1,1)),f.x),f.y),f.z); }\n'
      ) + sh.fragmentShader
        .replace('#include <color_fragment>',
          '#include <color_fragment>\n float pgrain = pnoise(vPaperWP*20.0)*0.62 + pnoise(vPaperWP*64.0)*0.38;\n diffuseColor.rgb *= (0.93 + 0.11*pgrain);')
        .replace('#include <roughnessmap_fragment>',
          '#include <roughnessmap_fragment>\n roughnessFactor = clamp(roughnessFactor + (pgrain-0.5)*0.28, 0.05, 1.0);');
    };
    m.customProgramCacheKey = () => 'paper-v1';
  });
  scene.add(model);
  applyPhase(phaseWanted);
}, undefined, () => { document.getElementById('fallback').style.display = 'grid'; });

/* ---- post: bloom for lantern light ---- */
const composer = new EffectComposer(renderer);
composer.addPass(new RenderPass(scene, camera));
const bloomPass = new UnrealBloomPass(new THREE.Vector2(innerWidth, innerHeight), 0.5, 0.55, 0.82);
composer.addPass(bloomPass);
composer.addPass(new OutputPass());

/* ---- scroll pilgrimage ---- */
const posCurve = new THREE.CatmullRomCurve3([
  new THREE.Vector3(19, 14, 23),
  new THREE.Vector3(6, 5.5, 19.5),
  new THREE.Vector3(0, 2.3, 17.6),
  new THREE.Vector3(-0.6, 1.8, 8.2),
  new THREE.Vector3(0, 2.1, 0.6),
  new THREE.Vector3(0, 2.4, -7.6),
  new THREE.Vector3(-3.4, 3.6, -1.2),
  new THREE.Vector3(16, 15, 20)
]);
const lookCurve = new THREE.CatmullRomCurve3([
  new THREE.Vector3(0, 1, -2),
  new THREE.Vector3(0, 2.4, 10),
  new THREE.Vector3(0, 3, 10.6),
  new THREE.Vector3(-2.4, 1.4, 2.6),
  new THREE.Vector3(0, 3, -6.8),
  new THREE.Vector3(0, 3.2, -11.8),
  new THREE.Vector3(-8.4, 4.6, -6.4),
  new THREE.Vector3(0, 1, -2)
]);
const caps = [...document.querySelectorAll('.cap')];
const CAP_AT = [0.0, 0.16, 0.34, 0.52, 0.68, 0.83, 0.97];
function scrollProgress(){
  const max = document.documentElement.scrollHeight - innerHeight;
  return max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
}
function updateScrollCam(){
  const p = scrollProgress();
  camera.position.copy(posCurve.getPoint(p));
  camera.lookAt(lookCurve.getPoint(p));
  let best = 0, bd = 1e9;
  CAP_AT.forEach((c, i) => { const d = Math.abs(p - c); if (d < bd) { bd = d; best = i; } });
  caps.forEach((c, i) => c.style.opacity = i === best ? String(Math.max(0, 1 - bd * 9)) : '0');
  document.getElementById('scrollHint').style.opacity = p > 0.02 ? '0' : '';
}

/* ---- free walk ---- */
const controls = new OrbitControls(camera, renderer.domElement);
controls.target.set(0, 1, -2);
controls.enableDamping = true; controls.dampingFactor = 0.06;
controls.maxPolarAngle = Math.PI * 0.495; controls.minDistance = 2.5; controls.maxDistance = 46;
controls.enabled = false;
let mode = 'scroll';
let tween = null;
function flyTo(pos, tgt){
  tween = { p0:camera.position.clone(), p1:new THREE.Vector3(...pos),
            t0:controls.target.clone(), t1:new THREE.Vector3(...tgt), s:performance.now() };
}
const SPOTS = {
  all:    [[19,14,23],[0,1,-2]],   sanmon: [[0,2.6,18.6],[0,3.2,10.6]],
  chozuya:[[-8.2,2.4,7.6],[-4.5,1.2,3.4]], hondo: [[0,3,2.2],[0,3.2,-6.8]],
  hodo:   [[0,3.4,-5.6],[0,3.4,-11.8]], pagoda: [[-14,4.6,0.5],[-8.4,4.6,-6.4]],
  bell:   [[12,2.8,4.2],[7.6,2.2,-0.8]]
};
const modeBtn = document.getElementById('modeBtn');
function setMode(m){
  mode = m;
  document.body.classList.toggle('free', m === 'free');
  controls.enabled = m === 'free';
  modeBtn.textContent = m === 'free' ? 'スクロール参拝へ' : '自由に歩く';
  if (m === 'free') { caps.forEach(c => c.style.opacity = '0'); flyTo(...SPOTS.all); }
  else { tween = null; scrollTo(0, 0); updateScrollCam(); }
}
modeBtn.addEventListener('click', () => setMode(mode === 'scroll' ? 'free' : 'scroll'));
document.querySelectorAll('#flyBar button').forEach(b => b.addEventListener('click', () => {
  document.querySelectorAll('#flyBar button').forEach(x => x.classList.toggle('on', x === b));
  if (mode !== 'free') setMode('free');
  flyTo(...SPOTS[b.dataset.fly]);
}));
document.querySelectorAll('#phaseBar button').forEach(b => b.addEventListener('click', () => { phaseWanted = b.dataset.phase; applyPhase(phaseWanted); }));
addEventListener('scroll', () => { if (mode === 'scroll') updateScrollCam(); }, { passive:true });

/* auto-enter free mode at the end of the pilgrimage */
let autoFreed = false;
function tick(){
  requestAnimationFrame(tick);
  if (tween) {
    const k = Math.min(1, (performance.now() - tween.s) / 1400);
    const e = k < .5 ? 2*k*k : 1 - Math.pow(-2*k + 2, 2) / 2;
    camera.position.lerpVectors(tween.p0, tween.p1, e);
    controls.target.lerpVectors(tween.t0, tween.t1, e);
    camera.lookAt(controls.target);
    if (k >= 1) tween = null;
  } else if (mode === 'free') {
    controls.update();
  }
  if (mode === 'scroll' && !autoFreed && scrollProgress() > 0.995) { autoFreed = true; setMode('free'); }
  composer.render();
}
addEventListener('resize', () => {
  camera.aspect = innerWidth/innerHeight; camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
  composer.setSize(innerWidth, innerHeight);
});
updateScrollCam();
tick();
</script>
</body>
</html>
